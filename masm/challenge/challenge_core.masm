#! Challenge mechanic, shared by `record.masm` and `shot.masm`.
#!
#! A champion posts a RECORD note holding the prize and a target score. A rival posts a SHOT note
#! holding their stake, bound to one record. Whoever beats the target with a verified answer takes
#! the prize and their stake back; a shot that is not won before its deadline is collected by the
#! champion.
#!
#! Both notes share one storage layout (64 felts for GeoQuizz). A shot note is its record note's
#! storage with `rival`, `shot_deadline` and `RECORD_ID` filled in, which is what lets the record
#! recognise it by storage commitment at claim time: the claimant supplies the shot's deadline
#! through the advice map (key = the shot note id), and the recomputed commitment only matches if
#! that is the deadline the note really carries.
#!
#!   0..1   champion        [suffix, prefix]
#!   2      target          score to beat (strictly greater wins)
#!   3      min_stake       minimum shot amount, in the record's asset
#!   4      expiry_block    record lifetime (claim window)
#!   5..6   rival           [suffix, prefix]   zero in a record note
#!   7      shot_deadline   block by which the rival must settle; zero in a record note
#!   8..11  RECORD_ID       zero in a record note
#!  12..15  SHOT_ROOT       script root of shot.masm
#!  16..    GAME DATA       opaque here; any length in whole words; the game reads it
#!
#! A shot settles before `min(shot_deadline, expiry_block)` and the champion collects from that
#! block on, so a rival cannot pick a deadline past the record's own life.
#!
#! The game plugs in one procedure, imported as `game::rules::beats_target` (link the game's module
#! under that path; `integration/src/scripts.rs` shows how):
#!   [ANSWER, data_ptr, target] -> [beats]
#! ANSWER is the note argument (one Word), whatever the game makes of it (GeoQuizz: the commitment
#! to ten packed answers it reads from the advice map), data_ptr points at the game data, target is
#! felt 2.
#!
#! Both notes must hold exactly one asset. Consuming accounts must expose the standard
#! `basic::receive_asset` procedure (every standard wallet does).

use miden::protocol::account_id
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::asset
use miden::protocol::input_note
use miden::protocol::note
use miden::protocol::tx
use miden::standards::wallets::basic
use game::rules

# CONSTANTS
# =================================================================================================

pub const HEADER_ITEMS = 16
pub const MAX_STORAGE_ITEMS = 256
pub const STORAGE_PTR = 0
pub const CHAMPION_SUFFIX_PTR = 0
pub const CHAMPION_PREFIX_PTR = 1
pub const TARGET_PTR = 2
pub const MIN_STAKE_PTR = 3
pub const EXPIRY_PTR = 4
pub const RIVAL_SUFFIX_PTR = 5
pub const RIVAL_PREFIX_PTR = 6
pub const SHOT_DEADLINE_PTR = 7
pub const RECORD_ID_PTR = 8
pub const SHOT_ROOT_PTR = 12
pub const GAME_DATA_PTR = 16

# scratch memory
const NUM_ITEMS_PTR = 260            # this note's storage length
const EXPECTED_PTR = 512             # expected challenge storage (same length)
const EXPECTED_RIVAL_SUFFIX_PTR = 517
const EXPECTED_RIVAL_PREFIX_PTR = 518
const EXPECTED_DEADLINE_PTR = 519
const EXPECTED_RECORD_ID_PTR = 520
const EXPECTED_COMMITMENT_PTR = 768
const FOUND_PTR = 772
const ASSET_PTR = 1024               # this note's assets (up to 16 x 8 felts)
const OTHER_ASSET_PTR = 1152         # a shot note's initial assets, same layout
const OTHER_ASSET_VALUE_PTR = 1156

#! A back-dated reference block buys at most this many blocks on the before-expiry paths.
pub const CLAIM_FUZZ = 64

# ERRORS
# =================================================================================================

const ERR_STORAGE_ITEMS = "challenge: note storage must hold the 16 header items plus game data in whole words"
const ERR_EXPIRED = "challenge: the deadline has passed"
const ERR_NOT_EXPIRED = "challenge: the deadline has not passed yet"
const ERR_ONE_ASSET = "challenge: the note must hold exactly one asset"
const ERR_WRONG_ASSET = "challenge: the shot's stake is not in the record's asset"
const ERR_STAKE_TOO_SMALL = "challenge: the shot's stake is below min_stake"
const ERR_NO_CHALLENGE = "challenge: no shot note bound to this record and consumer in the transaction"

# STORAGE
# =================================================================================================

#! Loads the note storage to STORAGE_PTR and records its length: 16 header items plus the game's
#! data, in whole words.
#!
#! Inputs:  []
#! Outputs: []
pub proc load_storage
    push.MAX_STORAGE_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items]
    dup u32gte.HEADER_ITEMS assert.err=ERR_STORAGE_ITEMS
    dup u32mod.4 assertz.err=ERR_STORAGE_ITEMS
    mem_store.NUM_ITEMS_PTR
end

# PARTIES
# =================================================================================================

#! Inputs:  []
#! Outputs: [is_champion]
pub proc is_consumer_champion
    mem_load.CHAMPION_PREFIX_PTR mem_load.CHAMPION_SUFFIX_PTR
    exec.active_account::get_id
    # => [acct_suffix, acct_prefix, champion_suffix, champion_prefix]
    exec.account_id::eq
end

#! Inputs:  []
#! Outputs: [is_player]
pub proc is_consumer_rival
    mem_load.RIVAL_PREFIX_PTR mem_load.RIVAL_SUFFIX_PTR
    exec.active_account::get_id
    exec.account_id::eq
end

# DEADLINES
# =================================================================================================

#! Inputs:  []
#! Outputs: [before_expiry]
proc before_expiry
    exec.tx::get_reference_block_number mem_load.EXPIRY_PTR
    # => [expiry, ref_block]
    lt
end

#! Aborts after the deadline and bounds how far the reference block may be back-dated.
#!
#! Inputs:  []
#! Outputs: []
pub proc assert_before_expiry
    exec.before_expiry assert.err=ERR_EXPIRED
    push.CLAIM_FUZZ exec.tx::update_expiration_block_delta
end

#! Inputs:  []
#! Outputs: []
pub proc assert_after_expiry
    exec.before_expiry assertz.err=ERR_NOT_EXPIRED
end

#! The block a shot note stops being settleable: the earlier of its own deadline and the
#! record expiry.
#!
#! Inputs:  []
#! Outputs: [deadline]
proc shot_deadline
    mem_load.SHOT_DEADLINE_PTR mem_load.EXPIRY_PTR u32min
end

#! Inputs:  []
#! Outputs: [before_deadline]
proc before_shot_deadline
    exec.tx::get_reference_block_number exec.shot_deadline
    # => [deadline, ref_block]
    lt
end

#! Inputs:  []
#! Outputs: []
pub proc assert_before_shot_deadline
    exec.before_shot_deadline assert.err=ERR_EXPIRED
    push.CLAIM_FUZZ exec.tx::update_expiration_block_delta
end

#! Inputs:  []
#! Outputs: []
pub proc assert_after_shot_deadline
    exec.before_shot_deadline assertz.err=ERR_NOT_EXPIRED
end

# VERDICT
# =================================================================================================

#! Asks the game whether the answer beats the target.
#!
#! Inputs:  [ANSWER]
#! Outputs: [beats_target]
pub proc answer_beats_target
    mem_load.TARGET_PTR movdn.4
    push.GAME_DATA_PTR movdn.4
    # => [ANSWER, data_ptr, target]
    exec.rules::beats_target
end

# ASSETS
# =================================================================================================

#! Moves all of this note's assets into the consumer's vault.
#!
#! Inputs:  []
#! Outputs: []
pub proc receive_all
    exec.basic::move_note_assets_to_account
end

#! Writes this note's single asset to ASSET_PTR.
#!
#! Inputs:  []
#! Outputs: []
proc load_own_asset
    push.ASSET_PTR exec.active_note::get_initial_assets
    # => [num_assets]
    eq.1 assert.err=ERR_ONE_ASSET
end

# CLAIM CHECK
# =================================================================================================

#! Computes the storage commitment the consumer's shot note for this record must have, given
#! the deadline that note claims, and stores it at EXPECTED_COMMITMENT_PTR.
#!
#! Inputs:  [shot_deadline]
#! Outputs: []
proc compute_expected_challenge_commitment
    # copy this note's storage, word by word
    mem_load.NUM_ITEMS_PTR push.0
    # => [i, n]
    dup dup.2 lt
    while.true
        padw dup.4 mem_loadw_le
        # => [WORD, i, n]
        dup.4 add.EXPECTED_PTR mem_storew_le dropw
        # => [i, n]
        add.4 dup dup.2 lt
    end
    drop drop

    # shot_deadline as claimed by the consumer (the commitment check proves it)
    mem_store.EXPECTED_DEADLINE_PTR

    # rival = consumer
    exec.active_account::get_id
    # => [acct_suffix, acct_prefix]
    mem_store.EXPECTED_RIVAL_SUFFIX_PTR mem_store.EXPECTED_RIVAL_PREFIX_PTR

    # RECORD_ID = this note
    exec.active_note::get_note_id
    mem_storew_le.EXPECTED_RECORD_ID_PTR dropw

    mem_load.NUM_ITEMS_PTR push.EXPECTED_PTR exec.note::compute_storage_commitment
    # => [COMMITMENT]
    mem_storew_le.EXPECTED_COMMITMENT_PTR dropw
end

#! Checks that input note `i` is the consumer's shot note for this record and that its stake
#! is acceptable; sets FOUND_PTR when it is. Aborts if a matching note carries the wrong asset or
#! too small a stake.
#!
#! The advice map must hold, under the id of every challenge-script input note, that note's
#! `shot_deadline` (one felt); the recomputed commitment proves the value.
#!
#! Inputs:  [i]
#! Outputs: [i]
proc check_input_note
    dup exec.input_note::get_script_root
    # => [ROOT, i]
    padw mem_loadw_le.SHOT_ROOT_PTR
    eqw movdn.8 dropw dropw
    # => [root_matches, i]
    if.true
        dup exec.input_note::get_note_id
        # => [NOTE_ID, i]
        adv.push_mapval adv_push
        # => [shot_deadline, NOTE_ID, i]
        movdn.4 dropw
        # => [shot_deadline, i]
        exec.compute_expected_challenge_commitment
        # => [i]
        dup exec.input_note::get_storage_info
        # => [COMMITMENT, num_items, i]
        movup.4 drop
        padw mem_loadw_le.EXPECTED_COMMITMENT_PTR
        eqw movdn.8 dropw dropw
        # => [storage_matches, i]
        if.true
            # the stake the challenge was created with: input notes run in the client's order, so
            # its own script may already have emptied the note by now
            dup push.OTHER_ASSET_PTR
            # => [dest_ptr, i, i]
            exec.input_note::get_initial_assets
            # => [num_assets, i]
            eq.1 assert.err=ERR_ONE_ASSET
            padw mem_loadw_le.OTHER_ASSET_PTR padw mem_loadw_le.ASSET_PTR
            # => [OWN_ASSET_ID, ASSET_ID, i]
            eqw assert.err=ERR_WRONG_ASSET
            dropw dropw
            padw mem_loadw_le.OTHER_ASSET_VALUE_PTR
            # => [ASSET_VALUE, i]
            exec.asset::fungible_value_into_amount_unchecked
            # => [amount, i]
            mem_load.MIN_STAKE_PTR lt
            # => [amount < min_stake, i]
            assertz.err=ERR_STAKE_TOO_SMALL
            push.1 mem_store.FOUND_PTR
        end
    end
end

#! Aborts unless the transaction also consumes the consumer's shot note for this record, in the
#! record's asset, with at least `min_stake`.
#!
#! Inputs:  []
#! Outputs: []
pub proc assert_challenge_present
    exec.load_own_asset
    push.0 mem_store.FOUND_PTR

    exec.tx::get_num_input_notes push.0
    # => [i, n]
    dup dup.2 lt
    # => [i < n, i, n]
    while.true
        exec.check_input_note
        add.1
        dup dup.2 lt
    end
    drop drop
    mem_load.FOUND_PTR assert.err=ERR_NO_CHALLENGE
end

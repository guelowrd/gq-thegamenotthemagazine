#! CHALLENGE note: a challenger's stake, bound to one prize note.
#!
#! Paths:
#! - settle:  the player, before the challenge deadline (and the prize expiry), with a WINNING
#!            ANSWER as the note argument: the stake comes back. A losing answer cannot settle;
#!            the stake then simply waits for the champion.
#! - collect: the champion, from the challenge deadline on.
#!
#! Inputs:  [ANSWER]
#! Outputs: []

use {NoteArgs} from miden::protocol::types
use challenge::core

const ERR_CHALLENGE_NOT_A_PARTY = "challenge: only the player or the champion may consume this note"
const ERR_CHALLENGE_NOT_WON = "challenge: the answer does not beat the target, the stake waits for the champion"

@note_script
pub proc main(args: NoteArgs)
    exec.core::load_storage
    exec.core::is_consumer_player
    # => [is_player, ANSWER]
    if.true
        exec.core::assert_before_challenge_deadline
        exec.core::answer_beats_target
        # => [beats_target]
        assert.err=ERR_CHALLENGE_NOT_WON
        exec.core::receive_all
    else
        dropw
        exec.core::is_consumer_champion assert.err=ERR_CHALLENGE_NOT_A_PARTY
        exec.core::assert_after_challenge_deadline
        exec.core::receive_all
    end
end
